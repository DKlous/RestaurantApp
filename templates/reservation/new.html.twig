{% extends 'base.html.twig' %}

{% block title %}{{ 'staff.book_table'|trans }} — {{ 'staff.label'|trans }}{% endblock %}

{% block body %}
    <section class="section">
        <div class="container reservation-form-page">
            <div class="page-heading">
                <span class="section-kicker">{{ 'staff.new_kicker'|trans }}</span>
                <h1>{{ 'staff.book_table'|trans }}</h1>
                <p class="muted">{{ 'staff.new_intro'|trans }}</p>
            </div>

            {% if errors is not empty %}
                <div class="alert alert--error" role="alert">
                    <span aria-hidden="true">⚠️</span>
                    <div><strong>{{ 'staff.check'|trans }}</strong><ul>{% for error in errors %}<li>{{ error }}</li>{% endfor %}</ul></div>
                </div>
            {% endif %}

            <div class="info-grid reservation-form-layout">
                <div class="card">
                    {{ form_start(form) }}
                    <div class="form-grid">
                        <div class="field field--full">
                            {{ form_label(form.table, null, {'label_attr': {'class': 'field-label'}}) }}
                            {{ form_widget(form.table) }}
                            {{ form_errors(form.table) }}
                        </div>
                        <div class="field">
                            {{ form_label(form.date, null, {'label_attr': {'class': 'field-label'}}) }}
                            {{ form_widget(form.date) }}
                            {{ form_errors(form.date) }}
                        </div>
                        <div class="field">
                            {{ form_label(form.time, null, {'label_attr': {'class': 'field-label'}}) }}
                            {{ form_widget(form.time) }}
                            {{ form_errors(form.time) }}
                        </div>
                        <div class="field">
                            {{ form_label(form.guests, null, {'label_attr': {'class': 'field-label'}}) }}
                            {{ form_widget(form.guests) }}
                            {{ form_errors(form.guests) }}
                        </div>
                        <div class="field">
                            {{ form_label(form.durationMinutes, null, {'label_attr': {'class': 'field-label'}}) }}
                            {{ form_widget(form.durationMinutes) }}
                            <span class="field__hint">{{ 'staff.duration_hint'|trans }}</span>
                            {{ form_errors(form.durationMinutes) }}
                        </div>
                    </div>
                    <div class="form-actions">
                        <button class="btn" type="submit">{{ 'staff.book_table'|trans }}</button>
                        <a class="btn btn--ghost" href="{{ path('reservation_dashboard') }}">{{ 'staff.back'|trans }}</a>
                    </div>
                    {{ form_end(form) }}
                </div>

                <aside class="card card--soft reservation-form-note">
                    <span class="section-kicker">{{ 'staff.good_to_know'|trans }}</span>
                    <h2>{{ 'staff.availability'|trans }}</h2>
                    <p>{{ 'staff.availability_text'|trans }}</p>
                    <p>{{ 'staff.change_text'|trans }}</p>
                    <p class="muted">{{ 'staff.hours_text'|trans }}</p>
                </aside>
            </div>
        </div>
    </section>
{% endblock %}
