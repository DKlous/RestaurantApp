# .env.example — veilige VOORBEELD-waarden voor de RestaurantApp.
# Kopieer naar .env bij een schone clone:  cp .env.example .env
#
# Dit bestand bevat géén échte secrets: alles hieronder is een dev-voorbeeld.
# Echte secrets gaan naar .env.local (ge-gitignore'd) of een secrets-store.
# https://symfony.com/doc/current/configuration/secrets.html
#
# Ladevolgorde (het laatst gelade heeft voorrang; échte omgevingsvariabelen wint van alles):
#   1. .env
#   2. .env.local            (niet ge-committet — lokale overrides / echte secrets)
#   3. .env.$APP_ENV         (bv. .env.dev, ge-committet)
#   4. .env.$APP_ENV.local   (niet ge-committet)

###> symfony/framework-bundle ###
APP_ENV=dev
# Vervang dit voor productie — in dev mag een voorbeeldwaarde staan.
APP_SECRET=change_me_dev_secret
APP_SHARE_DIR=var/share
###< symfony/framework-bundle ###

###> symfony/routing ###
DEFAULT_URI=http://localhost
###< symfony/routing ###

###> doctrine/doctrine-bundle ###
# Lokale waarde (host): wijst naar de op de host geëxposeerde MariaDB-poort (3306).
# Binnen Docker overschrijft de 'php'-service dit naar de interne hostname 'db'
# (zie de environment-blok van 'php' in docker-compose.yml).
DATABASE_URL="mysql://restaurant:restaurant_secret_dev@127.0.0.1:3306/restaurant?charset=utf8mb4"

# MariaDB (gebruikt door de 'db'-service via compose-interpolatie). DEV-voorbeelden.
MARIADB_DATABASE=restaurant
MARIADB_USER=restaurant
MARIADB_PASSWORD=restaurant_secret_dev
MARIADB_ROOT_PASSWORD=restaurant_root_secret_dev
###< doctrine/doctrine-bundle ###
